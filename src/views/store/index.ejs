<!DOCTYPE html>
<html lang="ru">

    <head>
        <meta charset="UTF-8">
        <link rel="stylesheet" href="/style.css">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title><%= title %></title>
    </head>

    <body>
        <nav class="navbar">
            <a href="/">Главная</a>
            <a href="/products">Товары</a>
            <a href="/departments">Филиалы</a>
            <a href="/sellers">Продавцы</a>
            <a href="/store">Склад</a>
        </nav>

        <% if (error) { %>
        <div class="error">
            <%= error %>
        </div>
        <% } else { %>

        <div class="container">
            <div class="card" style="display: flex; justify-content: space-between; align-items: center;">
                <h1>Управление складом</h1>
                <a href="/store/create" class="btn-action">Добавить товар</a>
            </div>

            <div class="grid" style="margin-bottom: 0px;">
                <div class="card">
                    <div class="stat-number">
                        Всего позиций
                    </div>
                    <div class="stat-label"><%= totalItems || 0 %></div>
                </div>
                <div class="card">
                    <div class="stat-number">Сумма (₽)</div>
                    <div class="stat-label"><%= (totalValue || 0).toLocaleString() %> тыс.</div>
                </div>
                <div class="card">
                    <div class="stat-number">Мало</div>
                    <div class="stat-label"><%= lowStockItems || 0 %></div>
                </div>
            </div>

            <table id="storeTable">
                <thead>
                    <tr>
                        <th>Товар</th>
                        <th>Категория</th>
                        <th>Количество</th>
                        <th>Цена</th>
                        <th>Общая стоимость</th>
                        <th>Позиция</th>
                        <th>Статус</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (storeItems && storeItems.length > 0) { %>
                    <% storeItems.forEach(item => { 
                            const totalPrice = (item.count || 0) * (item.products.price || 0);
                            let status = 'Достаточно';
                            let statusClass = 'badge-normal';
                            if (item.count === 0) {
                                status = 'Отсутствует';
                                statusClass = 'badge-empty';
                            } else if (item.count < 10) {
                                status = 'Мало';
                                statusClass = 'badge-low';
                            }
                        %>
                    <tr>
                        <td>
                            <%= item.products.name %>
                        </td>
                        <td><%= item.products.category %></td>
                        <td><%= item.count || 0 %> шт.</td>
                        <td><%= item.products.price.toLocaleString() || 0 %> ₽</td>
                        <td><%= totalPrice.toLocaleString() %> ₽</td>
                        <td>
                            <% if (item.position) { %>
                            <span class="position-tag"><%= item.position %></span>
                            <% } %>
                        </td>
                        <td><span class="stock-badge <%= statusClass %>"><%= status %></span></td>
                        <td>
                            <a href="/store/<%= item.id %>" class="btn">Просмотр</a>

                        </td>
                    </tr>
                    <% }) %>
                    <% } else { %>
                    <tr>
                        <td colspan="8" style="text-align: center; padding: 3rem;">
                            <p style="color: #7f8c8d; margin-bottom: 1rem;">На складе нет товаров</p>
                            <a href="/store/create" class="btn-action">Добавить товар</a>
                        </td>
                    </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
        <% } %>
    </body>

</html>