<!DOCTYPE html>
<html lang="ru">

    <head>
        <meta charset="UTF-8">
        <link rel="stylesheet" href="/style.css">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title><%= title %> </title>
    </head>

    <body>
        <nav class="navbar">
            <a href="/">Главная</a>
            <a href="/products">Товары</a>
            <a href="/departments">Филиалы</a>
            <a href="/sellers">Продавцы</a>
            <a href="/store">Склад</a>
        </nav>

        <% if (error) { %>
        <div class="error">
            <%= error %>
        </div>
        <% } else { %>

        <div class="container">
            <div class="card">
                <h1>Редактирование позиции "<%= storeItem.products.name %>" %></h1>
            </div>

            <form action="/store/<%= storeItem.id %>?_method=PUT" method="POST" id="editForm">
                <div class="form-group">

                    <label for="count">
                        Количество на складе
                    </label>
                    <input type="number" id="count" name="count" value="<%= storeItem.count %>" min="0" step="1" required>
                    <label for="position">
                        Позиция на складе
                    </label>
                    <input type="text" id="position" name="position" value="<%= storeItem.position || '' %>" placeholder="Стеллаж А, полка 3">
                    <div style="display: flex; gap: 1rem;">
                        <button type="submit" class="btn-action" style="border: none;" id="submitBtn">
                            <span class="btn-text">Сохранить</span>
                        </button>
                        <a href="/store" class="btn">Отмена</a>
                    </div>
                </div>
            </form>
        </div>
        <% } %>
    </body>

</html>