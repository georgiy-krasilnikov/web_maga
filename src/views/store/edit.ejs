<!DOCTYPE html>
<html lang="ru">

    <head>
        <meta charset="UTF-8">
        <link rel="stylesheet" href="/style.css">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title><%= title %> </title>
        <style>
            .form-container
            {
                max-width: 600px;
                margin: 0 auto;
                background: white;
                padding: 2rem;
                border-radius: 12px;
                box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
            }

            .form-container h1
            {
                color: #2c3e50;
                margin-bottom: 2rem;
                padding-bottom: 1rem;
                border-bottom: 3px solid #f39c12;
            }

            .product-card
            {
                background: #f8f9fa;
                padding: 1.5rem;
                border-radius: 8px;
                margin-bottom: 2rem;
                display: flex;
                align-items: center;
                gap: 1.5rem;
                border: 1px solid #e0e0e0;
            }

            .product-icon
            {
                width: 70px;
                height: 70px;
                background: #e1f0fa;
                border-radius: 12px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 2rem;
                color: #2980b9;
            }

            .product-details
            {
                flex: 1;
            }

            .product-name
            {
                font-size: 1.5rem;
                font-weight: 600;
                color: #2c3e50;
                margin-bottom: 0.3rem;
            }

            .product-meta
            {
                color: #7f8c8d;
                font-size: 0.95rem;
                display: flex;
                gap: 1rem;
                flex-wrap: wrap;
            }

            .product-meta span
            {
                display: flex;
                align-items: center;
                gap: 0.3rem;
            }

            .product-price
            {
                font-weight: bold;
                color: #27ae60;
                font-size: 1.1rem;
            }

            .form-group
            {
                margin-bottom: 1.5rem;
            }

            .form-group label
            {
                display: block;
                margin-bottom: 0.5rem;
                font-weight: 600;
                color: #34495e;
            }

            .form-group label i
            {
                margin-right: 0.3rem;
                color: #7f8c8d;
            }

            .form-group input
            {
                width: 100%;
                padding: 0.75rem;
                border: 2px solid #e0e0e0;
                border-radius: 8px;
                font-size: 1rem;
                transition: all 0.3s;
            }

            .form-group input:focus
            {
                outline: none;
                border-color: #f39c12;
                box-shadow: 0 0 0 3px rgba(243, 156, 18, 0.1);
            }

            .form-group input[type="number"]
            {
                -moz-appearance: textfield;
            }

            .form-group input[type="number"]::-webkit-outer-spin-button,
            .form-group input[type="number"]::-webkit-inner-spin-button
            {
                -webkit-appearance: none;
                margin: 0;
            }

            .stock-status
            {
                background: #f0f9f0;
                padding: 1rem;
                border-radius: 8px;
                margin-bottom: 1.5rem;
                border-left: 4px solid #27ae60;
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

            .stock-status.warning
            {
                background: #fff3cd;
                border-left-color: #f39c12;
            }

            .stock-status.danger
            {
                background: #f8d7da;
                border-left-color: #e74c3c;
            }

            .stock-label
            {
                font-weight: 600;
                color: #2c3e50;
            }

            .stock-value
            {
                font-size: 1.2rem;
                font-weight: bold;
            }

            .stock-value.normal
            {
                color: #27ae60;
            }

            .stock-value.warning
            {
                color: #f39c12;
            }

            .stock-value.danger
            {
                color: #e74c3c;
            }

            .position-preview
            {
                background: #e1f0fa;
                color: #2980b9;
                padding: 0.5rem;
                border-radius: 8px;
                margin-top: 0.5rem;
                display: none;
                font-size: 0.9rem;
            }

            .position-preview.show
            {
                display: block;
            }

            .button-group
            {
                display: flex;
                gap: 1rem;
                margin-top: 2rem;
                padding-top: 1rem;
                border-top: 2px solid #ecf0f1;
            }

            .btn
            {
                flex: 1;
                padding: 1rem;
                font-size: 1rem;
                border: none;
                border-radius: 8px;
                cursor: pointer;
                text-align: center;
                text-decoration: none;
                font-weight: 600;
                transition: all 0.3s;
            }

            .btn-warning
            {
                background: linear-gradient(135deg, #f39c12, #e67e22);
                color: white;
            }

            .btn-warning:hover
            {
                background: linear-gradient(135deg, #e67e22, #d35400);
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(243, 156, 18, 0.3);
            }

            .btn-danger
            {
                background: linear-gradient(135deg, #e74c3c, #c0392b);
                color: white;
            }

            .btn-danger:hover
            {
                background: linear-gradient(135deg, #c0392b, #a93226);
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(231, 76, 60, 0.3);
            }

            .btn
            {
                background: linear-gradient(135deg, #95a5a6, #7f8c8d);
                color: white;
            }

            .btn:hover
            {
                background: linear-gradient(135deg, #7f8c8d, #6c7a7d);
                transform: translateY(-2px);
            }

            .alert
            {
                padding: 1rem;
                background: #f8d7da;
                color: #721c24;
                border: 1px solid #f5c6cb;
                border-radius: 8px;
                margin-bottom: 1.5rem;
            }

            .info-text
            {
                font-size: 0.9rem;
                color: #7f8c8d;
                margin-top: 0.3rem;
                display: flex;
                align-items: center;
                gap: 0.3rem;
            }

            .info-text i
            {
                color: #3498db;
            }

            .quick-actions
            {
                display: flex;
                gap: 0.5rem;
                margin: 1rem 0;
                flex-wrap: wrap;
            }

            .quick-btn
            {
                padding: 0.5rem 1rem;
                border: 1px solid #e0e0e0;
                border-radius: 20px;
                background: white;
                cursor: pointer;
                font-size: 0.9rem;
                transition: all 0.3s;
            }

            .quick-btn:hover
            {
                background: #f0f0f0;
                border-color: #b0b0b0;
            }

            @media (max-width: 768px)
            {
                .product-card
                {
                    flex-direction: column;
                    text-align: center;
                }

                .product-meta
                {
                    justify-content: center;
                }

                .button-group
                {
                    flex-direction: column;
                }

                .stock-status
                {
                    flex-direction: column;
                    gap: 0.5rem;
                    text-align: center;
                }
            }
        </style>
    </head>

    <body>
        <nav class="navbar">
            <a href="/">Главная</a>
            <a href="/products">Товары</a>
            <a href="/departments">Филиалы</a>
            <a href="/sellers">Продавцы</a>
            <a href="/store">Склад</a>
        </nav>

        <% if (error) { %>
        <div class="error">
            <%= error %>
        </div>
        <% } else { %>

        <div class="container">
            <div class="form-container">
                <h1><%= title %></h1>
                <!-- Информация о товаре -->
                <div class="product-card">
                    <div class="product-icon">
                        📦
                    </div>
                    <div class="product-details">
                        <div class="product-name">
                            <a href="/products/<%= storeItem.products.id %>" style="color: inherit; text-decoration: none;">
                                <%= storeItem.products.name %>
                            </a>
                        </div>
                        <div class="product-meta">
                            <span><%= storeItem.products.category %></span>
                            <span><span class="product-price"><%= storeItem.products.price.toLocaleString() %> ₽</span></span>
                        </div>
                    </div>
                </div>

                <!-- Текущий статус -->
                <% 
                let statusClass = 'normal';
                let statusText = 'В наличии';
                if (storeItem.count === 0) {
                    statusClass = 'danger';
                    statusText = 'Нет в наличии';
                } else if (storeItem.count < 10) {
                    statusClass = 'warning';
                    statusText = 'Мало';
                }
            %>
                <div class="stock-status <%= statusClass %>">
                    <span class="stock-label">Текущий статус:</span>
                    <span class="stock-value <%= statusClass %>">
                        <%= storeItem.count %> шт. - <%= statusText %>
                    </span>
                </div>

                <!-- Форма редактирования -->
                <form action="/store/<%= storeItem.id %>?_method=PUT" method="POST" id="editForm">
                    <div class="form-group">
                        <label for="count">
                            Количество на складе
                        </label>
                        <input type="number" id="count" name="count" value="<%= storeItem.count %>" min="0" step="1" required>
                        <div class="info-text">
                            Введите новое количество товара
                        </div>
                    </div>

                    <!-- Быстрые действия для изменения количества -->
                    <div class="quick-actions">
                        <button type="button" class="quick-btn" onclick="adjustCount(1)">+1</button>
                        <button type="button" class="quick-btn" onclick="adjustCount(5)">+5</button>
                        <button type="button" class="quick-btn" onclick="adjustCount(10)">+10</button>
                        <button type="button" class="quick-btn" onclick="adjustCount(-1)">-1</button>
                        <button type="button" class="quick-btn" onclick="adjustCount(-5)">-5</button>
                        <button type="button" class="quick-btn" onclick="adjustCount(-10)">-10</button>
                    </div>

                    <div class="form-group">
                        <label for="position">
                            Позиция на складе
                        </label>
                        <input type="text" id="position" name="position" value="<%= storeItem.position || '' %>" placeholder="Например: Стеллаж А, полка 3">
                        <div class="info-text">
                            Укажите точное место хранения для удобного поиска
                        </div>
                        <!-- <div class="position-preview" id="positionPreview">
                            Позиция будет: <span id="previewText"></span>
                        </div> -->
                    </div>

                    Предпросмотр общей стоимости
                    <!-- <div class="stock-status" style="background: #e8f4f8; border-left-color: #3498db;">
                        <span class="stock-label">Общая стоимость после изменений:</span>
                        <span class="stock-value" style="color: #2980b9;" id="totalPreview">
                            <%= (storeItem.count * storeItem.products.price).toLocaleString() %> ₽
                        </span>
                    </div> -->

                    <div class="button-group">
                        <button type="submit" class="btn btn-warning" id="submitBtn">
                            <span class="btn-text">Сохранить изменения</span>
                        </button>
                        <a href="/store" class="btn">Отмена</a>
                    </div>
                </form>

                <div style="margin-top: 2rem; padding: 1rem; background: #fef5f5; border-radius: 8px;">
                    <!-- <h3 style="color: #e74c3c; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
                        <span>⚠️</span> Опасная зона
                    </h3> -->
                    <form action="/store/<%= storeItem.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Вы точно уверены? Это действие удалит товар со склада.');">
                        <button type="submit" class="btn btn-danger" style="width: auto; padding: 0.75rem 2rem;">
                            Удалить
                        </button>
                    </form>
                </div>
            </div>
        </div>
        <% } %>

