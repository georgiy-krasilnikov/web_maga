<!DOCTYPE html>
<html lang="ru">

    <head>
        <meta charset="UTF-8">
        <link rel="stylesheet" href="/style.css">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title><%= title %></title>
    </head>

    <body>
        <nav class="navbar">
            <a href="/">Главная</a>
            <a href="/products">Товары</a>
            <a href="/departments">Филиалы</a>
            <a href="/sellers">Продавцы</a>
            <a href="/store">Склад</a>
        </nav>

        <% if (error) { %>
        <div class="error">
            <%= error %>
        </div>
        <% } else { %>

        <div class="container">
            <div class="card">
                <div class="profile-header">
                    <h1>Позиция "<%= storeItem.products.name %>"</h1>
                    <div style="display: flex; gap: 1rem;">
                        <a href="/store/<%= storeItem.id %>/edit" class="btn-action">Редактировать</a>
                        <form action="/store/<%= storeItem.id %>?_method=DELETE" method="POST" style="display: inline;">
                            <button type="submit" class="btn" style="border: none;" onclick="return confirm('Удалить товар со склада?')">Удалить</button>
                        </form>
                    </div>
                </div>
                <h3 style="margin-bottom: 20px;">Информация о товаре:</h3>
                <div class="info-row">
                    <span class="info-label">Категория:</span>
                    <span style="color: black;">
                        <%= storeItem.products.category %>
                    </span>
                </div>
                <div class="info-row">
                    <span class="info-label">Описание:</span>
                    <span style="color: black;">
                        <%= storeItem.products.description || 'Нет описания' %>
                    </span>
                </div>
                <div class="info-row">
                    <span class="info-label">Цена:</span>
                    <span style="color: black;">
                        <%= storeItem.products.price.toLocaleString() %> ₽
                    </span>
                </div>
                <div class="info-row">
                    <span class="info-label">Сумма:</span>
                    <span style="color: black;">
                        <%= ((storeItem.count * storeItem.products.price) / 1000).toFixed(2).toLocaleString() %> тыс. ₽
                    </span>
                </div>

                <h3 style="margin-bottom: 20px;">Информация о складе:</h3>
                <div class="info-row">
                    <span class="info-label">Количество:</span>
                    <% 
                                let stockClass = 'normal';
                                if (storeItem.count === 0) stockClass = 'danger';
                                else if (storeItem.count < 10) stockClass = 'warning';
                            %>
                    <span class="stock-value <%= stockClass %>"><%= storeItem.count %> шт.</span>
                </div>

                <div class="info-row">
                    <span class="info-label">Позиция:</span>
                    <span><%= storeItem.position || "Отсутствует" %></span>
                </div>

                <div class="info-row">
                    <span class="info-label">Статус:</span>
                    <% if (storeItem.count === 0) { %>
                    <span style="color: #e74c3c; font-weight: bold;">Нет в наличии</span>
                    <% } else if (storeItem.count < 10) { %>
                    <span style="color: #f39c12; font-weight: bold;">Мало</span>
                    <% } else { %>
                    <span style="color: #27ae60; font-weight: bold;">В наличии</span>
                    <% } %>
                </div>
            </div>
        </div>
        <% } %>
    </body>

</html>