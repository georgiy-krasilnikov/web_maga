<!DOCTYPE html>
<html lang="ru">

    <head>
        <meta charset="UTF-8">
        <link rel="stylesheet" href="/style.css">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title><%= title %></title>
    </head>

    <body>
        <nav class="navbar">
            <a href="/">Главная</a>
            <a href="/products">Товары</a>
            <a href="/departments">Филиалы</a>
            <a href="/sellers">Продавцы</a>
            <a href="/store">Склад</a>
        </nav>

        <% if (error) { %>
        <div class="error">
            <%= error %>
        </div>
        <% } else { %>

        <div class="container">
            <div class="card">
                <h1>Добавить товар на склад</h1>
            </div>
            <form action="/store" method="POST">
                <div class="form-group">
                    <label for="product_id">Товар <span class="required">*</span></label>
                    <select id="product_id" name="product_id" required>
                        <% if (products && products.length > 0) { %>
                        <% products.forEach(product => { %>
                        <option value="<%= product.id %>">
                            <%= product.name %>
                        </option>
                        <% }) %>
                        <% } %>
                    </select>
                    <label for="count">Количество <span class="required">*</span></label>
                    <input type="number" id="count" name="count" min="1" value="1" required>
                    <label for="position">Позиция на складе</label>
                    <input type="text" id="position" name="position" placeholder="Стеллаж А, полка 3">


                    <div style="display: flex; gap: 1rem;">
                        <button type="submit" class="btn-action" style="border: none;" id="submitBtn">
                            Добавить
                        </button>
                        <a href="/store" class="btn">Отмена</a>
                    </div>
                </div>
            </form>
        </div>
        <% } %>
    </body>

</html>