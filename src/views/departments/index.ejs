<!DOCTYPE html>
<html lang="ru">

<head>
    <meta charset="UTF-8">
    <link rel="stylesheet" href="/style.css">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %> - Управление магазином
    </title>
</head>

<body>
    <nav class="navbar">
        <a href="/">Главная</a>
        <a href="/products">Товары</a>
        <a href="/departments">Филиалы</a>
        <a href="/sellers">Продавцы</a>
        <a href="/store">Склад</a>
    </nav>

    <div class="card" style="display: flex; justify-content: space-between; align-items: center;">
        <h1>Управление филиалами</h1>
        <a href="/departments/create" class="btn btn-success">Добавить филиал</a>
    </div>
    <div class="card">
        <table>
            <thead>
                <tr>
                    <th>Название</th>
                    <th>Описание</th>
                    <th>Количество продавцов</th>
                    <th>Количество товаров</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                <% departments.forEach(department=> { %>
                    <tr>
                        <td>
                            <%= department.name %>
                        </td>
                        <td>
                            <%= department.description || 'Нет описания' %>
                        </td>
                        <td>
                            <%= department.sellers ? department.sellers.length : 0 %>
                        </td>
                        <td>
                            <%= department.products ? department.products.length : 0 %>
                        </td>
                        <td>
                            <a href="/departments/<%= department.id %>" class="btn">Просмотр</a>
                            <a href="/departments/<%= department.id %>/edit" class="btn">Редактировать</a>
                            <form action="/departments/<%= department.id %>?_method=DELETE" method="POST"
                                style="display: inline;">
                                <button type="submit" class="btn btn-danger"
                                    onclick="return confirm('Вы уверены? Все связанные поставщики и их товары будут откреплены')">Удалить</button>
                            </form>
                        </td>
                    </tr>
                    <% }) %>
            </tbody>
        </table>
    </div>
</body>

</html>