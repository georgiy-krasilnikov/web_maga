<!DOCTYPE html>
<html lang="ru">

    <head>
        <meta charset="UTF-8">
        <link rel="stylesheet" href="/style.css">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>
            <%= title %>
        </title>
    </head>

    <body>
        <nav class="navbar">
            <a href="/">Главная</a>
            <a href="/products">Товары</a>
            <a href="/departments">Филиалы</a>
            <a href="/sellers">Продавцы</a>
            <a href="/store">Склад</a>
        </nav>

        <% if (error) { %>
        <div class="error">
            <%= error %>
        </div>
        <% } else { %>

        <div class="container">
            <div class="card" style="display: flex; justify-content: space-between; align-items: center;">
                <h1>Управление филиалами</h1>
                <a href="/departments/create" class="btn-action">Добавить филиал</a>
            </div>
            <% if (departments && departments.length > 0) { %>
            <table>
                <thead>
                    <tr>
                        <th>Название</th>
                        <th>Описание</th>
                        <th>Количество продавцов</th>
                        <th>Количество товаров</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    <% departments.forEach(department=> { %>
                    <tr>
                        <td>
                            <%= department.name %>
                        </td>
                        <td>
                            <%= department.description || 'Нет описания' %>
                        </td>
                        <td>
                            <%= department.sellers ? department.sellers.length : 0 %>
                        </td>
                        <td>
                            <%= department.products ? department.products.length : 0 %>
                        </td>
                        <td>
                            <a href=" /departments/<%= department.id %>" class="btn">Просмотр</a>
                        </td>
                    </tr>
                    <% }) %>
                    <tr>
                        <td colspan="5" style="text-align: center;">
                            <a href="/departments/create" class="btn-action">Добавить филиал</a>
                        </td>
                    </tr>
                </tbody>
            </table>
            <% } else { %>
            <h3>Филиалов пока нет</h3>
            <% } %>
        </div>
        <% } %>
    </body>

</html>