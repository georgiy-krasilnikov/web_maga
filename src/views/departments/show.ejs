<!DOCTYPE html>
<html lang="ru">

    <head>
        <meta charset="UTF-8">
        <link rel="stylesheet" href="/style.css">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>
            <%= title %>
        </title>
    </head>

    <body>
        <nav class="navbar">
            <a href="/">Главная</a>
            <a href="/products">Товары</a>
            <a href="/departments">Филиалы</a>
            <a href="/sellers">Продавцы</a>
            <a href="/store">Склад</a>
        </nav>

        <% if (error) { %>
        <div class="error">
            <%= error %>
        </div>
        <% } else { %>

        <div class="container">
            <div class="card" style="display: flex; justify-content: space-between; align-items: center;">
                <div>
                    <h1>
                        <%= department.name %>
                    </h1>
                    <p style="margin-top: 15px; color: #bfbfbf; font-weight: bold;">
                        <%= department.description || 'Нет описания' %>
                    </p>
                </div>
                <div style="display: flex; gap: 1rem;">
                    <a href="/departments/<%= department.id %>/edit" class="btn-action">Редактировать</a>
                    <form action="/departments/<%= department.id %>?_method=DELETE" method="POST" style="display: inline;">
                        <button type="submit" class="btn" style="border: none;" onclick="return confirm('Вы уверены?')">Удалить</button>
                    </form>
                </div>
            </div>

            <div class="grid" style="margin-bottom: 0px;">
                <div class="card">
                    <div class="stat-number">
                        Товаров
                        <div class="stat-label"><%= totalProducts %></div>
                    </div>
                </div>
                <div class="card">
                    <div class="stat-number">
                        Продавцов
                        <div class="stat-label"><%= totalSellers %></div>
                    </div>
                </div>
                <div class="card">
                    <div class="stat-number">
                        Сумма (₽)
                        <div class="stat-label"><%= totalValue.toLocaleString() %> тыс.</div>
                    </div>
                </div>
            </div>

            <% if (department.sellers && department.sellers.length> 0) { %>
            <div class="card">
                <h3>Продавцы филиала</h3>
            </div>
            <table style="margin-bottom: 20px;">
                <thead>
                    <tr>
                        <th>Имя</th>
                        <th>Email</th>
                        <th>Телефон</th>
                        <th>Товаров</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    <% department.sellers.forEach(seller=> { %>
                    <tr>
                        <td>
                            <%= seller.name %>
                        </td>
                        <td>
                            <%= seller.email %>
                        </td>
                        <td>
                            <%= seller.phone %>
                        </td>
                        <td>
                            <%= seller.products?.length || 0 %>
                        </td>
                        <td>
                            <a href="/sellers/<%= seller.id %>" class="btn">Просмотр</a>
                        </td>
                    </tr>
                    <% }) %>
                    <tr>
                        <td colspan="5" style="text-align: center;">
                            <a href="/sellers/create?department_id=<%= department.id %>" class="btn-action">Добавить продавца</a>
                        </td>
                    </tr>
                </tbody>
            </table>
            <% } else { %>
            <div class="card" style="display: flex; justify-content: space-between; align-items: center;">
                <h3>У этого филиала пока нет продавцов</h3>
                <a href="/sellers/create?department_id=<%= department.id %>" class="btn-action">Добавить продавца</a>
            </div>
            <% } %>

            <% if (department.products && department.products.length> 0) { %>
            <div class="card">
                <h3>Товары филиала</h3>
            </div>
            <table>
                <thead>
                    <tr>
                        <th>Название</th>
                        <th>Категория</th>
                        <th>Цена</th>
                        <th>Продавец</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    <% department.products.forEach(product=> { %>
                    <tr>
                        <td>
                            <%= product.name %>
                        </td>
                        <td>
                            <%= product.category %>
                        </td>
                        <td>
                            <%= product.price %> ₽
                        </td>
                        <td>
                            <%= product.sellers?.name || 'Не назначен' %>
                        </td>
                        <td>
                            <a href="/products/<%= product.id %>" class="btn">Просмотр</a>
                        </td>
                    </tr>
                    <% }) %>
                    <tr>
                        <td colspan="5" style="text-align: center;">
                            <a href="/products/create?department_id=<%= department.id %>" class="btn-action">Добавить товар</a>
                        </td>
                    </tr>
                </tbody>
            </table>
            <% } else { %>
            <div class="card" style="display: flex; justify-content: space-between; align-items: center;">
                <h3>В этом филиале пока нет товаров</h3>
                <% if (department.sellers && department.sellers.length> 0) { %>
                <a href="/products/create?department_id=<%= department.id %>" class="btn-action">Добавить товар</a>
                <% } %>
            </div>
            <% } %>
        </div>
        <% } %>
    </body>

</html>