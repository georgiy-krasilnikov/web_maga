<!DOCTYPE html>
<html lang="ru">

    <head>
        <meta charset="UTF-8">
        <link rel="stylesheet" href="/style.css">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>
            <%= title %>
        </title>
    </head>

    <body>
        <nav class="navbar">
            <a href="/">Главная</a>
            <a href="/products">Товары</a>
            <a href="/departments">Филиалы</a>
            <a href="/sellers">Продавцы</a>
            <a href="/store">Склад</a>
        </nav>

        <% if (error) { %>
        <div class="error">
            <%= error %>
        </div>
        <% } else { %>

        <div class="container">
            <div class="card">
                <h1>Редактирование филиала "<%= department.name %>"
                </h1>
            </div>
            <form action="/departments/<%= department.id %>?_method=PUT" method="POST">
                <div class="form-group">
                    <label for="name">Название филиала <span class="required">*</label>
                    <input type="text" id="name" name="name" value="<%= department.name %>" required>
                    <label for="description">Описание</label>
                    <input type="text" id="description" name="description" value="<%= department.description || '' %>">
                    <div style="display: flex; gap: 1rem;">
                        <button type="submit" class="btn-action" style="border: none;">Сохранить</button>
                        <a href="/departments" class="btn">Отмена</a>
                    </div>
            </form>
        </div>
        <% } %>
    </body>

</html>