<!DOCTYPE html>
<html lang="ru">

    <head>
        <meta charset="UTF-8">
        <link rel="stylesheet" href="/style.css">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>
            <%= title %>
        </title>
        <style>
            .readonly-field
            {
                background: #ecf0f1;
                padding: 0.75rem;
                border-radius: 8px;
                color: #2c3e50;
                font-weight: 500;
            }
        </style>
    </head>

    <body>
        <nav class="navbar">
            <a href="/">Главная</a>
            <a href="/products">Товары</a>
            <a href="/departments">Филиалы</a>
            <a href="/sellers">Продавцы</a>
            <a href="/store">Склад</a>
        </nav>

        <% if (error) { %>
        <div class="error">
            <%= error %>
        </div>
        <% } else { %>

        <div class="container">
            <div class="card">
                <h1>
                    Редактирование товара "<%= product.name %>"
                </h1>
            </div>
            <form action="/products/<%= product.id %>?_method=PUT" method="POST" id="editForm">
                <div class="form-group">
                    <label for="name">Название товара <span class="required">*</span></label>
                    <input type="text" id="name" name="name" value="<%= product.name %>" required>
                    <label for="description">Описание</label>
                    <input type="text" id="description" name="description"><%= product.description || '' %>

                    <div class="form-row">
                        <div class="form-field">
                            <label for="category">Категория <span class="required">*</span></label>
                            <input type="text" id="category" name="category" value="<%= product.category %>" required>
                        </div>
                        <div class="form-field">
                            <label for="price">Цена (₽) <span class="required">*</span></label>
                            <input type="number" id="price" name="price" value="<%= product.price %>" required min="0" step="1">
                        </div>
                        <div class="form-field">
                            <label for="seller_id">Продавец <span class="required">*</label>
                            <select id="seller_id" name="seller_id">
                                <% sellers.forEach(seller=> { %>
                                <option value="<%= seller.id %>" <%=product.seller_id==seller.id ? 'selected' : '' %>>
                                    <%= seller.name %>
                                </option>
                                <% }) %>
                            </select>
                        </div>
                    </div>

                    <% if (product.store) { %>
                    <label>Информация о складе</label>
                    <div class="info-row">
                        <span class="info-label">Количество:</span>
                        <span style="color: black;">
                            <%= product.store.count %> шт.
                        </span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Позиция:</span>
                        <span style="color: black;">
                            <%= product.store.position || 'Не указана' %>
                        </span>
                    </div>
                    <% } %>
                    <div style="display: flex; gap: 1rem;">
                        <button type="submit" class="btn-action" style="border: none;" id="submitBtn">
                            Сохранить
                        </button>
                        <a href="/products/<%= product.id %>" class="btn">Отмена</a>
                    </div>
                </div>
            </form>
        </div>
        <% } %>
    </body>

</html>