<!DOCTYPE html>
<html lang="ru">

    <head>
        <meta charset="UTF-8">
        <link rel="stylesheet" href="/style.css">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>
            <%= title %>
        </title>
        <style>
            .form-container
            {
                max-width: 800px;
                margin: 0 auto;
                background: white;
                padding: 2rem;
                border-radius: 12px;
                box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
            }

            .form-container h1
            {
                color: #2c3e50;
                margin-bottom: 2rem;
                padding-bottom: 1rem;
                border-bottom: 3px solid #f39c12;
            }

            .form-group
            {
                margin-bottom: 1.5rem;
            }

            .form-group label
            {
                display: block;
                margin-bottom: 0.5rem;
                font-weight: 600;
                color: #34495e;
            }

            .form-group label .required
            {
                color: #e74c3c;
                margin-left: 0.2rem;
            }

            .form-group input,
            .form-group select,
            .form-group textarea
            {
                width: 100%;
                padding: 0.75rem;
                border: 2px solid #e0e0e0;
                border-radius: 8px;
                font-size: 1rem;
                transition: all 0.3s;
                background: #f9f9f9;
            }

            .form-group input:focus,
            .form-group select:focus,
            .form-group textarea:focus
            {
                outline: none;
                border-color: #f39c12;
                background: white;
                box-shadow: 0 0 0 3px rgba(243, 156, 18, 0.1);
            }

            .form-row
            {
                display: flex;
                gap: 1rem;
                margin-bottom: 1rem;
            }

            .form-row .form-group
            {
                flex: 1;
            }

            .profit-preview
            {
                background: #f0f9f0;
                padding: 1rem;
                border-radius: 8px;
                margin: 1rem 0;
                border-left: 4px solid #27ae60;
            }

            .profit-amount
            {
                font-size: 1.2rem;
                font-weight: bold;
                color: #27ae60;
            }

            .profit-amount.negative
            {
                color: #e74c3c;
            }

            .button-group
            {
                display: flex;
                gap: 1rem;
                margin-top: 2rem;
                padding-top: 1rem;
                border-top: 2px solid #ecf0f1;
            }

            .btn
            {
                flex: 1;
                padding: 1rem;
                font-size: 1rem;
                border: none;
                border-radius: 8px;
                cursor: pointer;
                text-align: center;
                text-decoration: none;
                font-weight: 600;
                transition: all 0.3s;
            }

            .btn-warning
            {
                background: linear-gradient(135deg, #f39c12, #e67e22);
                color: white;
            }

            .btn-warning:hover
            {
                background: linear-gradient(135deg, #e67e22, #d35400);
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(243, 156, 18, 0.3);
            }

            .btn
            {
                background: linear-gradient(135deg, #95a5a6, #7f8c8d);
                color: white;
            }

            .btn:hover
            {
                background: linear-gradient(135deg, #7f8c8d, #6c7a7d);
                transform: translateY(-2px);
            }

            .btn-danger
            {
                background: linear-gradient(135deg, #e74c3c, #c0392b);
                color: white;
            }

            .alert
            {
                padding: 1rem;
                background: #f8d7da;
                color: #721c24;
                border: 1px solid #f5c6cb;
                border-radius: 8px;
                margin-bottom: 1.5rem;
            }

            .info-box
            {
                background: #e1f0fa;
                color: #2980b9;
                padding: 1rem;
                border-radius: 8px;
                margin-bottom: 1.5rem;
                display: flex;
                align-items: center;
                gap: 0.5rem;
            }

            .readonly-field
            {
                background: #ecf0f1;
                padding: 0.75rem;
                border-radius: 8px;
                color: #2c3e50;
                font-weight: 500;
            }

            @media (max-width: 768px)
            {
                .form-row
                {
                    flex-direction: column;
                    gap: 0;
                }

                .button-group
                {
                    flex-direction: column;
                }
            }
        </style>
    </head>

    <body>
        <nav class="navbar">
            <a href="/">Главная</a>
            <a href="/products">Товары</a>
            <a href="/departments">Филиалы</a>
            <a href="/sellers">Продавцы</a>
            <a href="/store">Склад</a>
        </nav>

        <% if (error) { %>
        <div class="error">
            <%= error %>
        </div>
        <% } else { %>

        <div class="container">
            <div class="form-container">
                <h1>
                    <%= title %>
                </h1>
                <div class="info-box">
                    <span>Редактирование товара <strong>
                            <%= product.name %>
                        </strong></span>
                </div>

                <form action="/products/<%= product.id %>?_method=PUT" method="POST" id="editForm">
                    <div class="form-group">
                        <label for="name">Название товара <span class="required">*</span></label>
                        <input type="text" id="name" name="name" value="<%= product.name %>" required>
                    </div>

                    <div class="form-group">
                        <label for="description">Описание</label>
                        <textarea id="description" name="description"><%= product.description || '' %></textarea>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label for="category">Категория <span class="required">*</span></label>
                            <input type="text" id="category" name="category" value="<%= product.category %>" required>
                        </div>

                        <div class="form-group">
                            <label for="price">Цена (₽) <span class="required">*</span></label>
                            <input type="number" id="price" name="price" value="<%= product.price %>" required min="0" step="1">
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label for="seller_id">Продавец <span class="required">*</label>
                            <select id="seller_id" name="seller_id">
                                <% sellers.forEach(seller=> { %>
                                <option value="<%= seller.id %>" <%=product.seller_id==seller.id ? 'selected' : '' %>>
                                    <%= seller.name %>
                                </option>
                                <% }) %>
                            </select>
                        </div>
                    </div>

                    <% if (product.store) { %>
                    <div class="form-group">
                        <label>Информация о складе</label>
                        <div class="readonly-field">
                            <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
                                <span>Количество:</span>
                                <strong>
                                    <%= product.store.count %> шт.
                                </strong>
                            </div>
                            <div style="display: flex; justify-content: space-between;">
                                <span>Позиция:</span>
                                <strong>
                                    <%= product.store.position || 'Не указана' %>
                                </strong>
                            </div>
                        </div>
                        <small style="color: #7f8c8d;">
                            Для изменения количества перейдите в
                            <a href="/store/<%= product.store.id %>/edit">управление складом</a>
                        </small>
                    </div>
                    <% } %>

                    <div class="button-group">
                        <button type="submit" class="btn btn-warning" id="submitBtn">
                            <span class="btn-text">Сохранить изменения</span>
                        </button>
                        <a href="/products/<%= product.id %>" class="btn">Отмена</a>
                    </div>
                </form>
            </div>
        </div>
        <% } %>
    </body>

</html>