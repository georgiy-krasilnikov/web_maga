<!DOCTYPE html>
<html lang="ru">

    <head>
        <meta charset="UTF-8">
        <link rel="stylesheet" href="/style.css">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>
            <%= title %>
        </title>
        <!-- <style>

        </style> -->
    </head>

    <body>
        <nav class="navbar">
            <a href="/">Главная</a>
            <a href="/products">Товары</a>
            <a href="/departments">Филиалы</a>
            <a href="/sellers">Продавцы</a>
            <a href="/store">Склад</a>
        </nav>
        <% if (error) { %>
        <div class="error">
            <%= error %>
        </div>
        <% } else { %>

        <div class="container">
            <div class="card">
                <h1>
                    Добавление нового товара
                </h1>
            </div>

            <form action="/products" method="POST">
                <div class="form-group">
                    <label for="name">Название товара <span class="required">*</label>
                    <input type="text" id="name" name="name" value="<%= product?.name || '' %>" required>
                    <label for="description">Описание</label>
                    <input type="text" id="description" name="description"><%= product?.description || '' %>
                    <div class="form-row">
                        <div class="form-field">
                            <label for="category">Категория <span class="required">*</label>
                            <input type="text" id="category" name="category" value="<%= product?.category || '' %>" required>
                        </div>
                        <div class="form-field">
                            <label for="price">Цена (₽) <span class="required">*</label>
                            <input type="number" id="price" name="price" value="<%= product?.price || '' %>" min="0" required>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-field">
                            <label for="department_id">Филиал</label>
                            <% if (selectedDepartmentId) { %>
                            <select id="department_id" name="department_id">
                                <% const selectedDept=departments.find(d=> d.id == selectedDepartmentId);
                                if (selectedDept) {
                                %>
                                <option value="<%= selectedDept.id %>">
                                    <%= selectedDept.name %>
                                </option>
                                <% } %>
                            </select>
                            <% } else if (selectedSellerId) { %>
                            <select id="department_id" name="department_id">
                                <% const selectedSeller=sellers.find(s=> s.id == selectedSellerId);
                                    if (selectedSeller) {
                                    %>
                                <% if (selectedSeller.department_id) { %>
                                <option value="<%= selectedSeller.department_id %>">
                                    <% const selectedDept=departments.find(d=> d.id == selectedSeller.department_id);
                                if (selectedDept) {
                                %>
                                    <%= selectedDept.name %>
                                    <% } %>
                                </option>
                                <% } else { %>
                                <option value=""> Без филиала </option>
                                <% } %>
                                <% } %>
                            </select>
                            <% } else { %>
                            <select id="department_id" name="department_id">
                                <option value=""> Выберите филиал </option>
                                <% departments.forEach(dept=> { %>
                                <option value="<%= dept.id %>">
                                    <%= dept.name %>
                                </option>
                                <% }) %>
                            </select>
                            <% } %>
                        </div>
                        <div class="form-field">
                            <label for="seller_id">Продавец <span class="required">*</label>
                            <% if (selectedSellerId) { %>
                            <select id="seller_id" name="seller_id">
                                <% const selectedSeller=sellers.find(s=> s.id == selectedSellerId);
                                if (selectedSeller) {
                                %>
                                <option value="<%= selectedSeller.id %>">
                                    <%= selectedSeller.name %>
                                </option>
                                <% } %>
                            </select>
                            <% } else if (selectedDepartmentId) { %>
                            <select id="seller_id" name="seller_id">
                                <% const selectedDept=departments.find(d=> d.id ==
                                    selectedDepartmentId);
                                    if (selectedDept) {
                                    %>
                                <option value=""> Выберите продавца </option>
                                <% selectedDept.sellers.forEach(seller=> { %>
                                <option value="<%= seller.id %>">
                                    <%= seller.name %>
                                </option>
                                <% }) %>
                            </select>
                            <% } %>
                            <% } else { %>
                            <select id="seller_id" name="seller_id">
                                <option value=""> Выберите продавца </option>
                                <% sellers.forEach(seller=> { %>
                                <option value="<%= seller.id %>">
                                    <%= seller.name %>
                                </option>
                                <% }) %>
                            </select>
                            <% } %>
                        </div>
                    </div>

                    <div class="checkbox-group">
                        <input type="checkbox" id="showStore" name="showStore" onclick="toggleStoreFields()">
                        <label for="showStore" class="info-label" style="width: 100%;">Добавить товар на склад
                        </label>
                    </div>

                    <div id="storeFields" style="display: none; margin-top: 20px;">
                        <div class="form-row">
                            <div class="form-field">
                                <label for="store_count">Количество</label>
                                <input type="number" id="store_count" name="store_count" value="" min="0">
                            </div>
                            <div class="form-field">
                                <label for="position">Позиция на складе</label>
                                <input type="text" id="position" name="position" placeholder="Стеллаж А, полка 1">
                            </div>
                        </div>
                    </div>

                    <div style="display: flex; gap: 1rem;">
                        <button type="submit" class="btn-action" style="border: none;">Сохранить</button>
                        <a href="/products" class="btn">Отмена</a>
                    </div>
                </div>
            </form>
        </div>
        <% } %>
    </body>

    <script>
        function toggleStoreFields()
        {
            const checkbox = document.getElementById('showStore');
            const storeFields = document.getElementById('storeFields');

            if (checkbox.checked)
            {
                storeFields.style.display = 'block';
            }
            else
            {
                storeFields.style.display = 'none';
            }
        }
    </script>

</html>