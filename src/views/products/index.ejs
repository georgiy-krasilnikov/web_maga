<div class="card" style="display: flex; justify-content: space-between; align-items: center;">
    <h1>Управление товарами</h1>
    <a href="/products/create" class="btn btn-success">Добавить товар</a>
</div>
<div class="card">
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Название</th>
                <th>Цена</th>
                <th>Себестоимость</th>
                <th>Категория</th>
                <th>Филиал</th>
                <th>Продавец</th>
                <th>На складе</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            <% products.forEach(product=> { %>
                <tr>
                    <td>
                        <%= product.id %>
                    </td>
                    <td>
                        <%= product.name %>
                    </td>
                    <td>
                        <%= product.price %> ₽
                    </td>
                    <td>
                        <%= product.cost_price %> ₽
                    </td>
                    <td>
                        <%= product.category %>
                    </td>
                    <td>
                        <%= product.departments ? product.departments.name : 'Не назначен' %>
                    </td>
                    <td>
                        <%= product.sellers ? product.sellers.name : 'Не назначен' %>
                    </td>
                    <td>
                        <%= product.stores ? product.stores.count : 0 %>
                    </td>
                    <td>
                        <a href="/products/<%= product.id %>" class="btn">Просмотр</a>
                        <a href="/products/<%= product.id %>/edit" class="btn">Редактировать</a>
                        <form action="/products/<%= product.id %>?_method=DELETE" method="POST"
                            style="display: inline;">
                            <button type="submit" class="btn btn-danger"
                                onclick="return confirm('Вы уверены?')">Удалить</button>
                        </form>
                    </td>
                </tr>
                <% }) %>
        </tbody>
    </table>
</div>