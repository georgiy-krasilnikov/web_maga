<!DOCTYPE html>
<html lang="ru">

    <head>
        <meta charset="UTF-8">
        <link rel="stylesheet" href="/style.css">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>
            <%= title %> - Управление магазином
        </title>
    </head>

    <body>
        <nav class="navbar">
            <a href="/">Главная</a>
            <a href="/products">Товары</a>
            <a href="/departments">Филиалы</a>
            <a href="/sellers">Продавцы</a>
            <a href="/store">Склад</a>
        </nav>

        <% if (error) { %>
        <div class="error">
            <%= error %>
        </div>
        <% } else { %>

        <div class="card">
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Название</th>
                        <th>Цена</th>
                        <th>Категория</th>
                        <th>Филиал</th>
                        <th>Продавец</th>
                        <th>На складе</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    <% products.forEach(product=> { %>
                    <tr>
                        <td>
                            <%= product.id %>
                        </td>
                        <td>
                            <%= product.name %>
                        </td>
                        <td>
                            <%= product.price %> ₽
                        </td>
                        <td>
                            <%= product.category %>
                        </td>
                        <td>
                            <%= product.departments ? product.departments.name : 'Нет' %>
                        </td>
                        <td>
                            <%= product.sellers.name %>
                        </td>
                        <td>
                            <%= product.store ? product.store.count : 0 %>
                        </td>
                        <td>
                            <a href="/products/<%= product.id %>" class="btn">Просмотр</a>
                            <form action="/products/<%= product.id %>?_method=DELETE" method="POST" style="display: inline;">
                                <button type="submit" class="btn btn-danger" onclick="return confirm('Вы уверены?')">Удалить</button>
                            </form>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
        <% } %>
    </body>

</html>