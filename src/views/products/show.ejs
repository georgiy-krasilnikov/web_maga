<!DOCTYPE html>
<html lang="ru">

    <head>
        <meta charset="UTF-8">
        <link rel="stylesheet" href="/style.css">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>
            <%= title %>
        </title>
        <style>
            .price-tag
            {
                font-size: 1.2rem;
                font-weight: bold;
                color: #27ae60;
            }

            .profit
            {
                font-size: 1.1rem;
                font-weight: 600;
            }

            .profit.positive
            {
                color: #27ae60;
            }

            .profit.negative
            {
                color: #e74c3c;
            }

            .badge
            {
                display: inline-block;
                padding: 0.3rem 0.8rem;
                border-radius: 20px;
                font-size: 0.9rem;
                font-weight: 500;
            }

            .badge-success
            {
                background: #d4edda;
                color: #155724;
            }

            .badge-warning
            {
                background: #fff3cd;
                color: #856404;
            }

            .badge-danger
            {
                background: #f8d7da;
                color: #721c24;
            }

            .store-card
            {
                background: white;
                padding: 2rem;
                border-radius: 12px;
                box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
                margin-bottom: 2rem;
            }

            .store-card h3
            {
                margin-bottom: 1.5rem;
                color: #2c3e50;
                display: flex;
                align-items: center;
                gap: 0.5rem;
            }

            .stock-info
            {
                display: flex;
                gap: 2rem;
                flex-wrap: wrap;
            }

            .stock-item
            {
                flex: 1;
                min-width: 200px;
            }

            .stock-label
            {
                font-size: 0.9rem;
                color: #7f8c8d;
                margin-bottom: 0.3rem;
            }

            .stock-value
            {
                font-size: 1.5rem;
                font-weight: bold;
                color: #2c3e50;
            }

            .stock-value.small
            {
                font-size: 1.2rem;
            }

            .position-tag
            {
                display: inline-block;
                background: #e1f0fa;
                color: #2980b9;
                padding: 0.5rem 1rem;
                border-radius: 8px;
                font-weight: 500;
            }
        </style>
    </head>

    <body>
        <nav class="navbar">
            <a href="/">Главная</a>
            <a href="/products">Товары</a>
            <a href="/departments">Филиалы</a>
            <a href="/sellers">Продавцы</a>
            <a href="/store">Склад</a>
        </nav>

        <% if (error) { %>
        <div class="error">
            <%= error %>
        </div>
        <% } else { %>

        <div class="container">
            <div class="card">
                <div class="profile-header">
                    <h1>
                        <%= product.name %>
                    </h1>
                    <div style="display: flex; gap: 1rem;">
                        <a href="/products/<%= product.id %>/edit" class="btn-action">
                            Редактировать
                        </a>
                        <form action="/products/<%= product.id %>?_method=DELETE" method="POST" style="display: inline;">
                            <button type="submit" class="btn" style="border: none;" onclick="return confirm('Вы уверены, что хотите удалить этот товар?')">
                                Удалить
                            </button>
                        </form>
                    </div>
                </div>

                <div class="info-row">
                    <span class="info-label">Категория:</span>
                    <span style="color: black;">
                        <%= product.category %>
                    </span>
                </div>
                <div class="info-row">
                    <span class="info-label">Описание:</span>
                    <span style="color: black;">
                        <%= product.description || 'Нет описания' %>
                    </span>
                </div>
                <div class="info-row">
                    <span class="info-label">Цена:</span>
                    <span style="color: black;">
                        <%= product.price.toLocaleString() %> ₽
                    </span>
                </div>
                <div class="info-row">
                    <span class="info-label">Филиал:</span>
                    <span>
                        <% if (product.departments) { %>
                        <div class="department-badge">
                            <a href="/departments/<%= product.departments.id %>" style="color: #085908; text-decoration: none;">
                                <%= product.departments.name %>
                            </a>
                        </div>
                        <% } else { %>
                        <span style="color: #b0b0b0;">Филиал не назначен</span>
                        <% } %>
                    </span>
                </div>

                <div class="info-row">
                    <span class="info-label">Продавец:</span>
                    <% if (product.sellers) { %>
                    <div class="department-badge" style="background: #e1f0fa;">
                        <a href="/sellers/<%= product.sellers.id %>" style="color: #186192; text-decoration: none;">
                            <%= product.sellers.name %>
                        </a>
                    </div>
                    <% } %>
                </div>
            </div>

            <div class="card">
                <h3>Наличие на складе</h3>
            </div>

            <% if (product.store) { %>
            <div class="grid">
                <div class="card">
                    <div class="stat-number">
                        Количество
                    </div>
                    <div class="stat-label">
                        <% if (product.store.count!==0) { %>
                        <%= product.store.count %> шт.
                        <% } else { %> Нет в наличии
                        <% } %>
                    </div>
                </div>
                <div class="card">
                    <div class="stat-number">
                        Сумма (₽)
                    </div>
                    <div class="stat-label"><%= ((product.store.count * product.price) / 1000).toFixed(2).toLocaleString() %> тыс.</div>
                </div>
                <div class="card">
                    <div class="stat-number">
                        Позиция на складе
                    </div>
                    <div class="stat-label"><% if (product.store.position) { %>
                        <%= product.store.position %>
                        <% } else { %>
                        Не указана
                        <% } %>
                    </div>
                </div>
            </div>
            <% } else { %>
            <div class="card" style="display: flex; justify-content: space-between; align-items: center;">
                <h3>Товар отсутствует на складе</h3>
                <a href="/store/create?product_id=<%= product.id %>" class="btn-action" style="width: 250px;">
                    Добавить товар на склад
                </a>
            </div>
            <% } %>
        </div>
        <% } %>
    </body>

</html>