<!DOCTYPE html>
<html lang="ru">

    <head>
        <meta charset="UTF-8">
        <link rel="stylesheet" href="/style.css">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>
            <%= title %>
        </title>
        <style>
            .product-header
            {
                display: flex;
                justify-content: space-between;
                align-items: start;
                margin-bottom: 2rem;
            }

            .product-info
            {
                background: white;
                padding: 2rem;
                border-radius: 12px;
                box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
                margin-bottom: 2rem;
            }

            .info-row
            {
                display: flex;
                padding: 0.75rem 0;
                border-bottom: 1px solid #ecf0f1;
            }

            .info-row:last-child
            {
                border-bottom: none;
            }

            .info-label
            {
                width: 150px;
                font-weight: 600;
                color: #7f8c8d;
            }

            .info-value
            {
                flex: 1;
                color: #2c3e50;
            }

            .price-tag
            {
                font-size: 1.2rem;
                font-weight: bold;
                color: #27ae60;
            }

            .profit
            {
                font-size: 1.1rem;
                font-weight: 600;
            }

            .profit.positive
            {
                color: #27ae60;
            }

            .profit.negative
            {
                color: #e74c3c;
            }

            .badge
            {
                display: inline-block;
                padding: 0.3rem 0.8rem;
                border-radius: 20px;
                font-size: 0.9rem;
                font-weight: 500;
            }

            .badge-success
            {
                background: #d4edda;
                color: #155724;
            }

            .badge-warning
            {
                background: #fff3cd;
                color: #856404;
            }

            .badge-danger
            {
                background: #f8d7da;
                color: #721c24;
            }

            .store-card
            {
                background: white;
                padding: 2rem;
                border-radius: 12px;
                box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
                margin-bottom: 2rem;
            }

            .store-card h3
            {
                margin-bottom: 1.5rem;
                color: #2c3e50;
                display: flex;
                align-items: center;
                gap: 0.5rem;
            }

            .stock-info
            {
                display: flex;
                gap: 2rem;
                flex-wrap: wrap;
            }

            .stock-item
            {
                flex: 1;
                min-width: 200px;
            }

            .stock-label
            {
                font-size: 0.9rem;
                color: #7f8c8d;
                margin-bottom: 0.3rem;
            }

            .stock-value
            {
                font-size: 1.5rem;
                font-weight: bold;
                color: #2c3e50;
            }

            .stock-value.small
            {
                font-size: 1.2rem;
            }

            .position-tag
            {
                display: inline-block;
                background: #e1f0fa;
                color: #2980b9;
                padding: 0.5rem 1rem;
                border-radius: 8px;
                font-weight: 500;
            }

            .action-buttons
            {
                display: flex;
                gap: 1rem;
                margin-top: 2rem;
            }

            .btn
            {
                padding: 0.75rem 1.5rem;
                border: none;
                border-radius: 8px;
                font-size: 1rem;
                cursor: pointer;
                text-decoration: none;
                display: inline-flex;
                align-items: center;
                gap: 0.5rem;
                transition: all 0.3s;
            }

            .btn-primary
            {
                background: #3498db;
                color: white;
            }

            .btn-primary:hover
            {
                background: #2980b9;
                transform: translateY(-2px);
            }

            .btn-warning
            {
                background: #f39c12;
                color: white;
            }

            .btn-warning:hover
            {
                background: #e67e22;
                transform: translateY(-2px);
            }

            .btn-danger
            {
                background: #e74c3c;
                color: white;
            }

            .btn-danger:hover
            {
                background: #c0392b;
                transform: translateY(-2px);
            }

            .btn-secondary
            {
                background: #95a5a6;
                color: white;
            }

            .btn-secondary:hover
            {
                background: #7f8c8d;
            }

            @media (max-width: 768px)
            {
                .info-row
                {
                    flex-direction: column;
                    gap: 0.3rem;
                }

                .info-label
                {
                    width: 100%;
                }

                .action-buttons
                {
                    flex-direction: column;
                }

                .btn
                {
                    width: 100%;
                    justify-content: center;
                }
            }
        </style>
    </head>

    <body>
        <nav class="navbar">
            <a href="/">Главная</a>
            <a href="/products">Товары</a>
            <a href="/departments">Филиалы</a>
            <a href="/sellers">Продавцы</a>
            <a href="/store">Склад</a>
        </nav>

        <% if (error) { %>
        <div class="error">
            <%= error %>
        </div>
        <% } else { %>

        <div class="container">
            <!-- Заголовок и кнопки действий -->
            <div class="product-header">
                <h1>
                    <%= product.name %>
                </h1>
                <div class="action-buttons">
                    <a href="/products/<%= product.id %>/edit" class="btn btn-warning">
                        Редактировать
                    </a>
                    <form action="/products/<%= product.id %>?_method=DELETE" method="POST" style="display: inline;">
                        <button type="submit" class="btn btn-danger" onclick="return confirm('Вы уверены, что хотите удалить этот товар?')">
                            Удалить
                        </button>
                    </form>
                </div>
            </div>

            <!-- Основная информация о товаре -->
            <div class="product-info">
                <h2 style="margin-bottom: 1.5rem;">Информация о товаре</h2>

                <div class="info-row">
                    <span class="info-label">Категория:</span>
                    <span class="info-value">
                        <span class="badge badge-success">
                            <%= product.category %>
                        </span>
                    </span>
                </div>

                <div class="info-row">
                    <span class="info-label">Описание:</span>
                    <span class="info-value">
                        <%= product.description || 'Нет описания' %>
                    </span>
                </div>

                <div class="info-row">
                    <span class="info-label">Цена:</span>
                    <span class="info-value price-tag">
                        <%= product.price.toLocaleString() %> ₽
                    </span>
                </div>
                <div class="info-row">
                    <span class="info-label">Филиал:</span>
                    <span class="info-value">
                        <% if (product.departments) { %>
                        <a href="/departments/<%= product.departments.id %>">
                            <%= product.departments.name %>
                        </a>
                        <% } else { %>
                        <span style="color: #999;">Не назначен</span>
                        <% } %>
                    </span>
                </div>

                <div class="info-row">
                    <span class="info-label">Продавец:</span>
                    <span class="info-value">
                        <% if (product.sellers) { %>
                        <a href="/sellers/<%= product.sellers.id %>">
                            <%= product.sellers.name %>
                        </a>
                        <% } else { %>
                        <span style="color: #999;">Не назначен</span>
                        <% } %>
                    </span>
                </div>
            </div>

            <!-- Информация о наличии на складе -->
            <div class="store-card">
                <h3>Наличие на складе</h3>

                <% if (product.store) { %>
                <div class="stock-info">
                    <div class="stock-item">
                        <div class="stock-label">Количество</div>
                        <div class="stock-value">
                            <%= product.store.count %> шт.
                            <% if (product.store.count===0) { %>
                            <span class="badge badge-danger">Нет в наличии</span>
                            <% } %>
                        </div>
                    </div>

                    <div class="stock-item">
                        <div class="stock-label">Общая стоимость</div>
                        <div class="stock-value small">
                            <%= (product.store.count * product.price).toLocaleString() %> ₽
                        </div>
                    </div>

                    <div class="stock-item">
                        <div class="stock-label">Позиция на складе</div>
                        <div class="stock-value small">
                            <% if (product.store.position) { %>
                            <span class="position-tag">
                                <%= product.store.position %>
                            </span>
                            <% } else { %>
                            <span style="color: #999;">Не указана</span>
                            <% } %>
                        </div>
                    </div>
                </div>

                <% } else { %>
                <div style="text-align: center; padding: 2rem;">
                    <p style="color: #7f8c8d; margin-bottom: 1rem;">Товар отсутствует на складе</p>
                    <a href="/store/create?product_id=<%= product.id %>" class="btn btn-primary">
                        Добавить на склад
                    </a>
                </div>
                <% } %>
            </div>

            <!-- Кнопка назад -->
            <div style="text-align: center; margin-top: 2rem;">
                <a href="/products" class="btn btn-secondary">Назад к списку товаров</a>
            </div>
        </div>
        <% } %>
    </body>

</html>