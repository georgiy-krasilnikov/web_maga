<!DOCTYPE html>
<html lang="ru">

    <head>
        <meta charset="UTF-8">
        <link rel="stylesheet" href="/style.css">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>
            <%= title %>
        </title>
    </head>

    <body>
        <nav class="navbar">
            <a href="/">Главная</a>
            <a href="/products">Товары</a>
            <a href="/departments">Филиалы</a>
            <a href="/sellers">Продавцы</a>
            <a href="/store">Склад</a>
        </nav>

        <% if (error) { %>
        <div class="error">
            <%= error %>
        </div>
        <% } else { %>

        <div class="container">
            <div class="card" style="display: flex; justify-content: space-between; align-items: center;">
                <h1 style="align-self: center">Управление продавцами</h1>
                <a href="/sellers/create" class="btn-action">Добавить продавца</a>
            </div>

            <% if (sellers && sellers.length> 0) { %>
            <div class="card">
                <input type="text" id="searchInput" class="search-box" placeholder="Поиск по имени">
            </div>

            <div class="grid">
                <% sellers.forEach(seller=> { %>
                <div class="seller-card" data-name="<%= seller.name.toLowerCase() %>">
                    <h3>
                        <%= seller.name %>
                    </h3>

                    <div class="seller-email">
                        <%= seller.email %>
                    </div>

                    <div class="seller-phone">
                        <%= seller.phone %>
                    </div>

                    <% if (seller.departments) { %>
                    <span class="department-badge">
                        <%= seller.departments.name %>
                    </span>
                    <% } else { %>
                    <span class="department-badge" style="background: #f0f0f0; color: #4f4e4e;">
                        Филиал не назначен
                    </span>
                    <% } %>

                    <div class="stats">
                        <div class="stat">
                            <div style="font-weight: bold; margin-bottom: 10px;">Товаров:</div>
                            <span style="color:#b0b0b0; font-weight: bold;">
                                <%= seller.products ? seller.products.length : 0 %> шт.
                            </span>

                        </div>
                        <div class="stat">
                            <div style="font-weight: bold; margin-bottom: 10px;">Сумма (₽):</div>
                            <span style="color:#b0b0b0; font-weight: bold;">
                                <% let totalValue=0; if (seller.products) { seller.products.forEach(p=>
                                                    totalValue += p.price);
                                                    }
                                                    %>
                                <%= (totalValue / 1000).toFixed(2) %> тыс.
                            </span>

                        </div>
                    </div>

                    <div class="actions">
                        <a href="/sellers/<%= seller.id %>" class="btn">Просмотр</a>
                        <form action="/sellers/<%= seller.id %>?_method=DELETE" method="POST" style="display: inline;">
                            <button type="submit" class="btn" style="border: none;" onclick="return confirm('Вы уверены? Все товары продавца будут удалены.')">
                                Удалить
                            </button>
                        </form>
                    </div>
                </div>
                <% }) %>
            </div>
            <% } else { %>
            <div class="card">
                <h3>Продавцов пока нет</h3>
            </div>
            <% } %>
        </div>
        <% } %>

        <script>
            document.getElementById('searchInput').addEventListener('keyup', function()
            {
                const searchText = this.value.toLowerCase();
                const cards = document.querySelectorAll('.seller-card');
                cards.forEach(card =>
                {
                    const name = card.dataset.name;
                    if (name.includes(searchText))
                    {
                        card.style.display = 'block';
                    }
                    else
                    {
                        card.style.display = 'none';
                    }
                });
            });
        </script>
    </body>

</html>