<!DOCTYPE html>
<html lang="ru">

    <head>
        <meta charset="UTF-8">
        <link rel="stylesheet" href="/style.css">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>
            <%= title %>
        </title>
    </head>

    <body>
        <nav class="navbar">
            <a href="/">Главная</a>
            <a href="/products">Товары</a>
            <a href="/departments">Филиалы</a>
            <a href="/sellers">Продавцы</a>
            <a href="/store">Склад</a>
        </nav>

        <% if (error) { %>
        <div class="error">
            <%= error %>
        </div>
        <% } else { %>

        <div class="container">
            <div class="card">
                <div class="profile-header">
                    <h1>
                        <%= seller.name %>
                    </h1>
                    <div style="display: flex; gap: 1rem;">
                        <a href="/sellers/<%= seller.id %>/edit" class="btn-action">Редактировать</a>
                        <form action="/sellers/<%= seller.id %>?_method=DELETE" method="POST" style="display: inline;">
                            <button type="submit" class="btn" style="border: none;" onclick="return confirm('Вы уверены? Все товары продавца будут удалены')">
                                Удалить
                            </button>
                        </form>
                    </div>
                </div>

                <div class="info-row">
                    <span class="info-label">Email:</span>
                    <span style="color: black;">
                        <%= seller.email %>
                    </span>
                </div>

                <div class="info-row">
                    <span class="info-label">Телефон:</span>
                    <span style="color: black;">
                        <%= seller.phone %>
                    </span>
                </div>

                <div class="info-row">
                    <span class="info-label">Филиал:</span>
                    <% if (seller.departments) { %>
                    <div class="department-badge"><a href="/departments/<%= seller.department_id %>" style="color: #085908; text-decoration: none;">
                            <%= seller.departments.name %>
                        </a>
                    </div>
                    <% } else { %>
                    <span style="color: #b0b0b0;">Филиал не назначен</span>
                    <% } %>
                    </span>
                </div>
            </div>

            <% let totalProducts=seller.products ? seller.products.length : 0; let totalValue=0; if (seller.products) {
                seller.products.forEach(p=> { totalValue += p.price; });
            }%>

            <div class="grid">
                <div class="card">
                    <div class="stat-number">
                        Товаров
                    </div>
                    <div class="stat-label"><%= totalProducts %></div>
                </div>
                <div class="card">
                    <div class="stat-number">
                        Сумма (₽)
                    </div>
                    <div class="stat-label"><%= (totalValue / 1000).toFixed(2).toLocaleString() %></div>
                </div>
            </div>

            <% if (seller.products && seller.products.length> 0) { %>
            <div class="card" style="margin-top: -30px;">
                <h3>Товары продавца</h3>
            </div>
            <table>
                <thead>
                    <tr>
                        <th>Название</th>
                        <th>Категория</th>
                        <th>Цена</th>
                        <th>Филиал</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    <% seller.products.forEach(product=> { %>
                    <tr>
                        <td>
                            <%= product.name %>
                        </td>
                        <td>
                            <%= product.category %>
                        </td>
                        <td>
                            <%= product.price.toLocaleString() %> ₽
                        </td>
                        <td>
                            <% if (product.departments) { %>
                            <%= product.departments.name %>
                            <% } else { %>
                            Не назначен
                            <% } %>
                        </td>
                        <td>
                            <a href="/products/<%= product.id %>" class="btn">Просмотр</a>
                        </td>
                    </tr>
                    <% }) %>
                    <tr>
                        <td colspan="5" style="text-align: center;">
                            <a href="/products/create?seller_id=<%= seller.id %>" class="btn-action">Добавить товар</a>
                        </td>
                    </tr>
                </tbody>
            </table>
            <% } else { %>
            <div class="card" style="display: flex; justify-content: space-between; align-items: center;">
                <h3>У этого продавца пока нет товаров</h3>
                <a href="/products/create?seller_id=<%= seller.id %>" class="btn-action">
                    Добавить товар
                </a>
            </div>
            <% } %>
        </div>
        <% } %>

    </body>

</html>