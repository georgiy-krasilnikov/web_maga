<!DOCTYPE html>
<html lang="ru">

    <head>
        <meta charset="UTF-8">
        <link rel="stylesheet" href="/style.css">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>
            <%= title %>
        </title>
        <style>
            .profile-header
            {
                display: flex;
                justify-content: space-between;
                align-items: start;
                margin-bottom: 2rem;
            }

            .profile-info
            {
                background: white;
                padding: 2rem;
                border-radius: 12px;
                box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
            }

            .info-row
            {
                display: flex;
                margin-bottom: 1rem;
                padding-bottom: 0.5rem;
                border-bottom: 1px solid #ecf0f1;
            }

            .info-label
            {
                width: 120px;
                font-weight: 600;
                color: #7f8c8d;
            }

            .info-value
            {
                flex: 1;
                color: #2c3e50;
            }

            .department-tag
            {
                display: inline-block;
                background: #3498db;
                color: white;
                padding: 0.3rem 1rem;
                border-radius: 20px;
                font-size: 0.9rem;
            }

            .stats-grid
            {
                display: grid;
                grid-template-columns: repeat(3, 1fr);
                gap: 1rem;
                margin: 2rem 0;
            }

            .stat-card
            {
                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                color: white;
                padding: 1.5rem;
                border-radius: 10px;
                text-align: center;
                box-shadow: 0 10px 20px rgba(102, 126, 234, 0.3);
            }

            .stat-card:nth-child(2)
            {
                background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
            }

            .stat-card:nth-child(3)
            {
                background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
            }

            .stat-value
            {
                font-size: 2.5rem;
                font-weight: bold;
                margin-bottom: 0.5rem;
            }

            .stat-label
            {
                font-size: 1rem;
                opacity: 0.9;
                text-transform: uppercase;
                letter-spacing: 1px;
            }

            .products-table
            {
                background: white;
                border-radius: 12px;
                overflow: hidden;
                box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
                margin-top: 2rem;
            }

            .products-table table
            {
                width: 100%;
                border-collapse: collapse;
            }

            .products-table th
            {
                background: #f8f9fa;
                padding: 1rem;
                text-align: left;
                font-weight: 600;
                color: #2c3e50;
            }

            .products-table td
            {
                padding: 1rem;
                border-bottom: 1px solid #ecf0f1;
            }

            .products-table tr:hover
            {
                background: #f8f9fa;
            }

            .profit
            {
                font-weight: 600;
            }

            .profit.positive
            {
                color: #27ae60;
            }

            .profit.negative
            {
                color: #e74c3c;
            }

            .action-buttons
            {
                display: flex;
                gap: 1rem;
                margin-top: 1rem;
            }

            .btn
            {
                padding: 0.75rem 1.5rem;
                border: none;
                border-radius: 8px;
                cursor: pointer;
                text-decoration: none;
                display: inline-block;
                font-weight: 500;
            }

            .btn-primary
            {
                background: #3498db;
                color: white;
            }

            .btn-warning
            {
                background: #f39c12;
                color: white;
            }

            .btn-danger
            {
                background: #e74c3c;
                color: white;
            }

            .empty-state
            {
                text-align: center;
                padding: 3rem;
                background: white;
                border-radius: 12px;
            }

            .empty-state p
            {
                color: #7f8c8d;
                margin-bottom: 1rem;
            }
        </style>
    </head>

    <body>
        <nav class="navbar">
            <a href="/">Главная</a>
            <a href="/products">Товары</a>
            <a href="/departments">Филиалы</a>
            <a href="/sellers">Продавцы</a>
            <a href="/store">Склад</a>
        </nav>

        <% if (error) { %>
        <div class="error">
            <%= error %>
        </div>
        <% } else { %>

        <div class="container">
            <!-- Профиль продавца -->
            <div class="profile-info">
                <div class="profile-header">
                    <h1>
                        <%= seller.name %>
                    </h1>
                    <div class="action-buttons">
                        <a href="/sellers/<%= seller.id %>/edit" class="btn btn-primary">Редактировать</a>
                        <form action="/sellers/<%= seller.id %>?_method=DELETE" method="POST" style="display: inline;">
                            <button type="submit" class="btn btn-danger" onclick="return confirm('Вы уверены? Все товары продавца будут удалены')">
                                Удалить
                            </button>
                        </form>
                    </div>
                </div>

                <div class="info-row">
                    <span class="info-label">Email:</span>
                    <span class="info-value">
                        <a href="mailto:<%= seller.email %>">
                            <%= seller.email %>
                        </a>
                    </span>
                </div>

                <div class="info-row">
                    <span class="info-label">Телефон:</span>
                    <span class="info-value">
                        <a href="tel:<%= seller.phone %>">
                            <%= seller.phone %>
                        </a>
                    </span>
                </div>

                <div class="info-row">
                    <span class="info-label">Филиал:</span>
                    <span class="info-value">
                        <% if (seller.departments) { %>
                        <span class="department-tag">
                            <a href="/departments/<%= seller.department_id %>" style="color: white; text-decoration: none;">
                                <%= seller.departments.name %>
                            </a>
                        </span>
                        <% } else { %>
                        <span style="color: #7f8c8d;">Филиал не назначен</span>
                        <% } %>
                    </span>
                </div>
            </div>

            <!-- Статистика -->
            <% let totalProducts=seller.products ? seller.products.length : 0; let totalValue=0; if (seller.products) {
            seller.products.forEach(p=> {
            totalValue += p.price;
            });
            }

            let avgPrice = totalProducts > 0 ? Math.round(totalValue / totalProducts) : 0;
            %>

            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-value">
                        <%= totalProducts %>
                    </div>
                    <div class="stat-label">Товаров</div>
                </div>

                <div class="stat-card">
                    <div class="stat-value">
                        <%= totalValue.toLocaleString() %> ₽
                    </div>
                    <div class="stat-label">Общая стоимость</div>
                </div>

                <div class="stat-card">
                    <div class="stat-value">
                        <%= avgPrice.toLocaleString() %> ₽
                    </div>
                    <div class="stat-label">Средняя стоимость</div>
                </div>
            </div>

            <!-- Товары продавца -->
            <div class="products-table">
                <h2 style="padding: 1.5rem; margin: 0;">Товары продавца</h2>

                <% if (seller.products && seller.products.length> 0) { %>
                <table>
                    <thead>
                        <tr>
                            <th>Название</th>
                            <th>Категория</th>
                            <th>Цена</th>
                            <th>Филиал</th>
                            <th>Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% seller.products.forEach(product=> {
                                %>
                        <tr>
                            <td><strong>
                                    <%= product.name %>
                                </strong></td>
                            <td>
                                <%= product.category %>
                            </td>
                            <td>
                                <%= product.price.toLocaleString() %> ₽
                            </td>
                            <td>
                                <% if (product.departments) { %>
                                <%= product.departments.name %>
                                <% } else { %>
                                <span style="color: #999;">Не назначен</span>
                                <% } %>
                            </td>
                            <td>
                                <a href="/products/<%= product.id %>" class="btn" style="padding: 0.3rem 0.8rem;">Просмотр</a>
                            </td>
                        </tr>
                        <% }) %>
                        <tr>
                            <td colspan="5" style="text-align: center; padding: 0.8rem;">
                                <a href="/products/create?seller_id=<%= seller.id %>" class="btn btn-success">Добавить товар</a>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <% } else { %>
                <div class="empty-state">
                    <p>У продавца пока нет товаров</p>
                    <a href="/products/create?seller_id=<%= seller.id %>" class="btn btn-primary">
                        Добавить товар
                    </a>
                </div>
                <% } %>
            </div>

            <div style="margin-top: 2rem; text-align: center;">
                <a href="/sellers" class="btn" style="background: #3498db; color: white;">Назад к списку продавцов</a>
            </div>
        </div>
        <% } %>
    </body>

</html>