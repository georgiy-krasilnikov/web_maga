<!DOCTYPE html>
<html lang="ru">

    <head>
        <meta charset="UTF-8">
        <link rel="stylesheet" href="/style.css">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>
            <%= title %>
        </title>
    </head>

    <body>
        <nav class="navbar">
            <a href="/">Главная</a>
            <a href="/products">Товары</a>
            <a href="/departments">Филиалы</a>
            <a href="/sellers">Продавцы</a>
            <a href="/store">Склад</a>
        </nav>

        <% if (error) { %>
        <div class="error">
            <%= error %>
        </div>
        <% } else { %>

        <div class="container">
            <div class="card">
                <h1>Редактирование продавца "<%= seller.name %>"</h1>
            </div>
            <form action="/sellers/<%= seller.id %>?_method=PUT" method="POST">
                <div class="form-group">
                    <label for="name">Имя продавца <span class="required">*</label>
                    <input type="text" id="name" name="name" value="<%= seller.name %>" required>
                    <label for="email">Email <span class="required">*</label>
                    <input type="email" id="email" name="email" value="<%= seller.email %>" required>
                    <label for="phone">Телефон <span class="required">*</label>
                    <input type="tel" id="phone" name="phone" value="<%= seller.phone %>" required>
                    <label for="department_id">Филиал <span class="required">*</label>
                    <select id="department_id" name="department_id">
                        <option value="">Без филиала</option>
                        <% if (departments && departments.length> 0) { %>
                        <% departments.forEach(dept=> { %>
                        <option value="<%= dept.id %>"><%= dept.name %> </option>
                        <% }) %>
                        <% } %>
                    </select>
                    <div style="display: flex; gap: 1rem;">
                        <button type="submit" class="btn" style="border: none;">Обновить</button>
                        <a href="/sellers/<%= seller.id %>" class="btn">Отмена</a>
                    </div>
                </div>
            </form>
        </div>
        <% } %>
    </body>

</html>