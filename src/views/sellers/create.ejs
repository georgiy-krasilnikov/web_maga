<!DOCTYPE html>
<html lang="ru">

    <head>
        <meta charset="UTF-8">
        <link rel="stylesheet" href="/style.css">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>
            <%= title %>
        </title>
    </head>

    <body>
        <nav class="navbar">
            <a href="/">Главная</a>
            <a href="/products">Товары</a>
            <a href="/departments">Филиалы</a>
            <a href="/sellers">Продавцы</a>
            <a href="/store">Склад</a>
        </nav>

        <% if (error) { %>
        <div class="error">
            <%= error %>
        </div>
        <% } else { %>

        <div class="container">
            <div class="card">
                <h1>Добавление продавца</h1>
            </div>
            <form action="/sellers" method="POST">
                <div class="form-group">
                    <label for="name">
                        Имя продавца <span class="required">*</span>
                    </label>
                    <input type="text" id="name" name="name" value="<%= seller?.name || '' %>" required placeholder="Иван Иванов">
                    <label for="email">
                        Email <span class="required">*</span>
                    </label>
                    <input type="email" id="email" name="email" value="<%= seller?.email || '' %>" required placeholder="example@mail.com">
                    <label for="phone">
                        Телефон <span class="required">*</span>
                    </label>
                    <input type="tel" id="phone" name="phone" value="<%= seller?.phone || '' %>" required placeholder="+79991234567">
                    <label for="department_id">Филиал</label>
                    <% if (selectedDepartmentId) { %>
                    <select id="department_id" name="department_id">
                        <% const selectedDept=departments.find(d=> d.id == selectedDepartmentId);
                                if (selectedDept) {
                                %>
                        <option value="<%= selectedDept.id %>">
                            <%= selectedDept.name %>
                        </option>
                        <% } %>
                    </select>
                    <% } else { %>
                    <select id="department_id" name="department_id">
                        <option value=""> Выберите филиал </option>
                        <% departments.forEach(dept=> { %>
                        <option value="<%= dept.id %>">
                            <%= dept.name %>
                        </option>
                        <% }) %>
                    </select>
                    <% } %>
                    <div style="display: flex; gap: 1rem;">
                        <button type="submit" class="btn" style="border: none" id="submitBtn">
                            <span class="btn-text">Создать</span>
                        </button>
                        <a href="/sellers" class="btn">Отмена</a>
                    </div>
                </div>
            </form>
        </div>
        <% } %>

