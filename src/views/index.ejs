<!DOCTYPE html>
<html lang="ru">

    <head>
        <meta charset="UTF-8">
        <link rel="stylesheet" href="/style.css">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>
            <%= title %>
        </title>
    </head>

    <body>
        <nav class="navbar">
            <a href="/">Главная</a>
            <a href="/products">Товары</a>
            <a href="/departments">Филиалы</a>
            <a href="/sellers">Продавцы</a>
            <a href="/store">Склад</a>
        </nav>

        <% if (error) { %>
        <div class="error">
            <%= error %>
        </div>
        <% } else { %>

        <div class="container">
            <div class="card">
                <h1>Панель управления магазином</h1>
            </div>

            <div class="grid">
                <div class="card">
                    <div class="stat-number">
                        Видов товара
                    </div>
                    <div class="stat-label"><%= totalProducts %></div>
                    <a href="/products" class="btn-action">Управление</a>
                </div>

                <div class="card">
                    <div class="stat-number">
                        Филиалов сети
                    </div>
                    <div class="stat-label"><%= totalDepartments %></div>
                    <a href="/departments" class="btn-action">Управление</a>
                </div>

                <div class="card">
                    <div class="stat-number">
                        Продавцов
                    </div>
                    <div class="stat-label"><%= totalSellers %></div>
                    <a href="/sellers" class="btn-action">Управление</a>
                </div>

                <div class="card">
                    <div class="stat-number">
                        На складе
                    </div>
                    <div class="stat-label"><%= totalStoreItems %></div>
                    <a href="/store" class="btn-action">Управление</a>
                </div>
            </div>
        </div>
        <% } %>
    </body>

</html>